# =========================================================================
# Proofline - example environment. PLACEHOLDERS ONLY.
#
# Every value below is a placeholder. Never commit real credentials, real
# receipt images, service-role keys or provider API keys. Copy this file to
# .env (which is gitignored) and fill in local development values.
#
# Naming convention:
#   *_PUBLIC_*  -> safe to embed in a client bundle
#   *_SERVER_*  -> server only, must never reach a client bundle
#   *_SECRET    -> server only, never logged
# =========================================================================

# --- Application ---------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_NAME=Proofline API
LOG_LEVEL=INFO
# Demo mode enables the demo identity switcher and the /api/v1/demo/* routes.
# MUST be false in any deployed environment.
DEMO_MODE=true
# Optional fictional rule fixture for local mechanics demonstrations only.
# Requires APP_ENV=development and DEMO_MODE=true; refused in staging/production.
DEMO_SYNTHETIC_POLICY_ENABLED=false

# --- Database ------------------------------------------------------------
# Matches docker-compose.yml (local development postgres).
DATABASE_URL=postgresql+psycopg://proofline:proofline@localhost:5432/proofline
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- HTTP / CORS ---------------------------------------------------------
# Comma-separated origins. The portal, console and Expo web dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# --- Authentication (Supabase Auth is the initial identity provider) -----
# PUBLISHABLE values may be used by clients. SERVER values must not.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_PUBLIC
SUPABASE_JWKS_URL=https://PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://PROJECT-REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Algorithms accepted for a Supabase access token. Asymmetric only: an HMAC or 'none'
# entry would let a token that was not signed by the project key through, so
# configuration refuses such a list at startup.
SUPABASE_JWT_ALGORITHMS=RS256,ES256

# Bounded clock skew applied to exp/nbf/iat, in seconds. Keep it small: a generous
# leeway is an extended token lifetime by another name.
SUPABASE_JWT_LEEWAY_SECONDS=30

# SERVER ONLY. Never expose, never commit a real value.
SUPABASE_SERVER_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# --- Receipt object storage (private bucket) ------------------------------
# local | supabase | s3
RECEIPT_STORAGE_BACKEND=local
RECEIPT_STORAGE_BUCKET=receipts-private
# Local development backend writes here. Must be outside any web root.
RECEIPT_LOCAL_ROOT=.local-storage/receipts
RECEIPT_MAX_UPLOAD_BYTES=10485760
# Short-lived signed URL lifetime in seconds for the supabase/s3 backends.
RECEIPT_SIGNED_URL_TTL_SECONDS=300
# SERVER ONLY.
SUPABASE_STORAGE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# --- Receipt extraction provider -----------------------------------------
# The verified local IndicOCR adapter uses a separate Python environment so its
# heavyweight Torch stack does not alter the pinned backend dependencies. Fill
# both paths only in the ignored local .env; never commit machine-specific paths.
# opencode_go | local_ocr | unavailable
EXTRACTION_PROVIDER=opencode_go
EXTRACTION_MODEL=REPLACE_WITH_LOCAL_INDIC_OCR_MODEL_DIRECTORY
EXTRACTION_PYTHON_EXECUTABLE=REPLACE_WITH_ISOLATED_INDICOCR_PYTHON_EXECUTABLE
# Bounded per-process provider concurrency/retry. Use one backend worker with local OCR.
EXTRACTION_TIMEOUT_SECONDS=90
EXTRACTION_CONCURRENCY=2
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BACKOFF_SECONDS=0.5
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# SERVER ONLY.
EXTRACTION_API_KEY=REPLACE_ME_SERVER_ONLY

# --- Client-facing configuration (safe to ship in bundles) ---------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Client builds must never enable this. Server DEMO_MODE decides demo routes.
# It is only honoured by the console, and only when no Supabase project is configured below.
NEXT_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_MODE=true
# Console sign-in. PUBLIC by design: the project URL and publishable/anon key authorize
# nothing on their own. Leave both empty for demo-only local development; set both to use
# real Supabase sessions. Never put the service-role key or a JWT secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
