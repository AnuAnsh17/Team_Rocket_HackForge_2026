# Employee Android app - client-visible configuration only.
#
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle, and an APK is trivially
# extractable. Never put a service-role key, an extraction API key, a database URL or any
# server credential here. The app talks to the backend API and to nothing else.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Demo identity switcher, for demonstrating that an employee sees only their own data.
# It is NOT a security boundary: the backend resolves the actor's memberships, roles and
# scope from its own database on every request, and refuses demo mode entirely when
# DEMO_MODE is off.
EXPO_PUBLIC_DEMO_MODE=true
