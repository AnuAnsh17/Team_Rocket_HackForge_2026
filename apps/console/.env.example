# Console (internal HR/Finance/Admin) - client-visible configuration only.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle. Never put a
# service-role key, an extraction API key or a database URL here: the console talks to
# the backend API and to nothing else.
#
# The version prefix is part of the base URL because every route is versioned.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Demo identity switcher. It is a convenience for demonstrating role-specific
# navigation, NOT a security boundary: the backend independently resolves roles and
# permissions for whatever actor id it receives, and refuses demo mode entirely when
# DEMO_MODE is off. Set to false for any non-demo build.
NEXT_PUBLIC_DEMO_MODE=true
