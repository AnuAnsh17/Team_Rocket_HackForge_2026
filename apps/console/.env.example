# Console (internal HR/Finance/Admin) - client-visible configuration only.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle. Never put a
# service-role key, an extraction API key or a database URL here: the console talks to
# the backend API and to nothing else.
#
# The version prefix is part of the base URL because every route is versioned.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Supabase Auth (the real sign-in path) --------------------------------
# Both values are PUBLIC by design and are the only Supabase values that may exist in a
# browser bundle. The project URL and the publishable/anon key identify the project; they
# authorize nothing on their own. The backend verifies the access token against the
# project's JWKS and loads roles and permissions from its own database, so holding these
# values grants no capability.
#
# Leave BOTH empty to run the console without a real identity provider (see demo mode
# below). A half-configured project - one value set and the other empty - is treated as
# not configured rather than as a broken sign-in.
#
# Never put SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_ISSUER, SUPABASE_JWKS_URL or any
# database URL in this file or behind a NEXT_PUBLIC_ name.
#
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Demo identity (development only) -------------------------------------
# The demo actor switcher identifies a user by id; it is NOT a role selector. The backend
# independently resolves roles and permissions for whatever actor id it receives, and
# refuses demo mode entirely when its own DEMO_MODE is off.
#
# It is active ONLY when NEXT_PUBLIC_DEMO_MODE=true AND no Supabase project is configured.
# The moment NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are both set, the
# demo actor header is not sent at all - a real session is the only way in.
#
# Set to false for any non-demo build.
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Hybrid local setup
#
# The console supports two local arrangements, chosen by the values above rather than by a
# code change:
#
# 1. Demo only (no Supabase project):
#      NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY empty
#      NEXT_PUBLIC_DEMO_MODE=true
#    The console sends X-Demo-Actor-Id. The backend must run with AUTH_PROVIDER=demo and
#    DEMO_MODE=true. A "Demo session - not a real sign-in" label is shown in the header.
#
# 2. Real Supabase sign-in:
#      NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY set
#      NEXT_PUBLIC_DEMO_MODE=false (or true; it is ignored once a project is configured)
#    The console sends Authorization: Bearer <access token>. The backend must run with
#    AUTH_PROVIDER=supabase plus SUPABASE_JWT_ISSUER and SUPABASE_JWKS_URL, and the signed-in
#    subject must already exist in users.external_subject with an active membership - a
#    valid token for an unprovisioned subject is a 401 and one with no membership is a 403.
# ---------------------------------------------------------------------------
