<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  `usesCleartextTraffic` is enabled here and only here, so the debug build can
  talk to a local backend over plain HTTP (the emulator reaches the host at
  10.0.2.2). The release build merges the main manifest, which does not set the
  flag, so Android's default - cleartext refused - applies.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true" />

</manifest>
