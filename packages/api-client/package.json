{
  "name": "@proofline/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript types for the Proofline API, plus a small typed fetch wrapper shared by the mobile app, the employee portal and the internal console.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts",
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "check": "node ./scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
