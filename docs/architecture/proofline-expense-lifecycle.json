  "cards": [
    {
      "dot": "cyan",
      "title": "Four Different Things",
      "items": [
        "Submitting is a status change on the claim row",
        "A policy check result is advisory: it writes nothing",
        "Approving, rejecting and escalating are human ReviewAction decisions",
        "No payment, payout or reimbursement execution exists in this build"
      ]
    },
    {
      "dot": "amber",
      "title": "Submit Gate (real conditions)",
      "items": [
        "Merchant, expense date, amount and currency on the persisted row",
        "At least one receipt attached; receipts only in draft or needs_info",
        "expected_version must match the row version, else 409 StaleVersion",
        "Own claim plus expense:submit_own, else 404 / 403",
        "Claim and receipt mutations require an Idempotency-Key header"
      ]
    },
    {
      "dot": "rose",
      "title": "Human Decisions and Their Limits",
      "items": [
        "Only submitted or in_review claims accept a decision, else 409",
        "Reject and request_correction need a human reason: 422 then DB CHECK",
        "A reviewer may not decide their own claim (403)",
        "in_review is the deferral target; escalated claims decide from there"
      ]
    },
    {
      "dot": "slate",
      "title": "Honest Boundaries",
      "items": [
        "Many findings, one status: a finding is never the claim's status",
        "UNKNOWN is never a pass and routes to review, never to approved",
        "Policy pre-flight UNKNOWN does not move the claim's status",
        "Withdrawn is reserved; finding and duplicate persistence stays deferred"
      ]
    }
  ]
